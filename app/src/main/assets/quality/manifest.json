{
  "manifest_version": 2,
  "name": "TV Nav Quality",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "tvnav-quality@tvdonghua.browser"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "all_frames": true,
      "js": ["quality.js"],
      "run_at": "document_idle"
    }
  ]
}
