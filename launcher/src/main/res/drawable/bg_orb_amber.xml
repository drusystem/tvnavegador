<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="54dp"
                android:centerX="50%"
                android:centerY="50%"
                android:startColor="#66FFE1A3"
                android:endColor="#00FFE1A3" />
        </shape>
    </item>
    <item android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp">
        <shape android:shape="oval">
            <stroke android:width="7dp" android:color="#FFFFF1CC" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:left="26dp" android:top="26dp" android:right="26dp" android:bottom="26dp">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#AAFFC46A" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
